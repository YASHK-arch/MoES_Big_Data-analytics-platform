# Copy to .env.demo and fill in your own secrets.
# This file is SAFE to commit — it contains no real credentials.
# .env.demo is gitignored and should never be committed.
#
# The scripts/demo-up.sh script auto-generates .env.demo with random values.

SECRET_KEY=replace-with-a-64-char-hex-random-string

POSTGRES_DB=weather_demo
POSTGRES_USER=weather_demo
POSTGRES_PASSWORD=replace-with-a-secure-password

MINIO_ROOT_USER=demoadmin
MINIO_ROOT_PASSWORD=replace-with-a-secure-password
S3_BUCKET_NAME=weather-media

ENVIRONMENT=production
DEBUG=false
ALLOWED_ORIGINS=http://localhost:8080
