# Application Configuration
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="National Weather Big Data Analytics Platform"
API_V1_STR=/api/v1

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL + PostGIS (Container & Backend)
POSTGRES_DB=weather_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/weather_platform
DATABASE_ECHO=false

# Cache & Event Streaming (Redis)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=weather-media
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PRESIGNED_EXPIRY_SECONDS=3600

# External Weather Portals (Optional in Local Dev)
DATA_GOV_API_KEY=
IMD_API_ENDPOINT=https://api.imd.gov.in/api/v1
IMD_API_KEY=
IMD_REQUEST_TIMEOUT_SECONDS=15.0
NDMA_SACHET_RSS_URL=https://sachet.ndma.gov.in/cap_public_website/FetchAllAlertDetails
# GDACS Global Disaster Alert and Coordination System
GDACS_ENDPOINT=https://www.gdacs.org/gdacsapi/api/events/geteventlist/SEARCH
# Central Water Commission (CWC) / NWDP Telemetry
# Default active datastore resource: Krishna River Basin (2026-2030) hourly telemetry
CWC_NWDP_API_ENDPOINT=https://nwdp.nwic.gov.in/api/3/action/datastore_search
CWC_NWDP_RESOURCE_ID=d80798b9-4b11-4626-8b63-964202ba7216
CWC_REQUEST_TIMEOUT_SECONDS=15.0
CWC_FETCH_LIMIT=50
# GDELT DOC 2.0 Web/News Evidence Feed
GDELT_DOC_ENDPOINT=http://api.gdeltproject.org/api/v2/doc/doc
GDELT_QUERY=sourcecountry:IN (flood OR "heavy rain" OR "waterlogging" OR cyclone OR landslide OR "heat wave" OR thunderstorm)
GDELT_MAX_RECORDS=50
GDELT_TIMESPAN=24h
GDELT_MIN_REQUEST_INTERVAL_SECONDS=5.0
GDELT_REQUEST_TIMEOUT_SECONDS=15.0
# Mastodon Public Social Posts (Instance is configurable; default reference: mastodon.social)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_HASHTAGS='["mumbairains", "delhirains", "bengalururains", "chennairains", "assamfloods", "monsoon", "flood", "cyclone", "heatwave"]'
MASTODON_MAX_RESULTS_PER_TAG=20
MASTODON_REQUEST_TIMEOUT_SECONDS=15.0
MASTODON_POLL_INTERVAL_SECONDS=30.0
MASTODON_MIN_REQUEST_INTERVAL_SECONDS=1.0

# AI & Semantic Intelligence / Deduplication Engine (v1 Initial Parameters)
DUPLICATE_SEMANTIC_METHOD=sparse_tfidf_ngram_v1
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
DUPLICATE_SPATIAL_RADIUS_METERS=2500.0
DUPLICATE_TIME_WINDOW_HOURS=3.0
DUPLICATE_SEMANTIC_THRESHOLD=0.50
DUPLICATE_CONFIRMED_THRESHOLD=0.75
DUPLICATE_POSSIBLE_THRESHOLD=0.55
DUPLICATE_CANDIDATE_LIMIT=50
DUPLICATE_ENGINE_VERSION=v1

# Evidence Linking Engine (v1 Initial Parameters)
EVIDENCE_LINK_ENGINE_VERSION=v1
EVIDENCE_SPATIAL_RADIUS_METERS=25000.0
EVIDENCE_TIME_WINDOW_HOURS=48.0
EVIDENCE_SUPPORTING_THRESHOLD=0.65
EVIDENCE_RELATED_THRESHOLD=0.45
EVIDENCE_CONTEXTUAL_THRESHOLD=0.35
EVIDENCE_CANDIDATE_LIMIT=50

# Observation Corroboration Engine (v1 — Water Level Policy Defaults)
CORROBORATION_ENGINE_VERSION=v1
CORROBORATION_WL_SPATIAL_RADIUS_METERS=35000.0
CORROBORATION_WL_TIME_WINDOW_HOURS=24.0
CORROBORATION_WL_TREND_LOOKBACK_HOURS=6.0
CORROBORATION_WL_FRESHNESS_MAX_HOURS=48.0
CORROBORATION_WL_TEMPORAL_PRIOR_FULL_HOURS=4.0
CORROBORATION_WL_TEMPORAL_POST_DECAY_RATE=0.7
CORROBORATION_WL_CORROBORATING_THRESHOLD=0.70
CORROBORATION_WL_CONSISTENT_THRESHOLD=0.45
CORROBORATION_WL_WEAK_THRESHOLD=0.25
CORROBORATION_CANDIDATE_LIMIT=50
CORROBORATION_CWC_SOURCE_TRUST=0.92

LLM_PROVIDER=none
LLM_API_KEY=

# CORS Allowed Origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
